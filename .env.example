# ToolBox - Environment Configuration Template
# Copy this file to .env.local for local development

# Base Application URL (Canonical URL root for SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense Configuration
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6319866397206659

# Ad Slot IDs (configured in Google AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=
