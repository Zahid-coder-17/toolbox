# ToolBox - Environment Configuration Template
# Copy this file to .env.local for local development

# Base Application URL (Canonical URL root for SEO)
# In production on Vercel, this matches: https://toolbox-1llw.vercel.app
NEXT_PUBLIC_SITE_URL=https://toolbox-1llw.vercel.app

# Google Search Console Verification Token (Server-Side)
# Set in Vercel project environment variables (or .env.local) with the token string from:
# <meta name="google-site-verification" content="TOKEN_HERE" />
GOOGLE_SITE_VERIFICATION=

# Google AdSense Configuration
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6319866397206659

# Ad Slot IDs (configured in Google AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=
